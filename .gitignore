:root {
  --bg: #f5f7fb;
  --panel: #ffffff;
  --panel-soft: #edf3ff;
  --panel-deep: #0f172a;
  --primary: #1477ff;
  --primary-strong: #0b5fe5;
  --primary-soft: rgba(20, 119, 255, 0.1);
  --text: #101828;
  --muted: #556070;
  --line: rgba(15, 23, 42, 0.08);
  --shadow: 0 22px 50px rgba(15, 23, 42, 0.08);
  --gold: #ffb703;
  --mint: #3ed7b8;
  --purple: #7b61ff;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: 'Inter', sans-serif;
  background: linear-gradient(180deg, #eff5ff 0%, #f9fafc 18%, #ffffff 100%);
  color: var(--text);
}

a {
  color: inherit;
  text-decoration: none;
}

button {
  font: inherit;
  cursor: pointer;
  border: 0;
  transition: all 0.2s ease;
}

img {
  max-width: 100%;
  display: block;
}

.page-shell {
  max-width: 1280px;
  margin: 0 auto;
  padding: 28px 24px 60px;
}

.topbar,
.site-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}

.brand-wrap {
  display: inline-flex;
  align-items: center;
  gap: 12px;
}

.brand-mark {
  position: relative;
  width: 26px;
  height: 26px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.brand-block {
  position: absolute;
  width: 18px;
  height: 18px;
  border-radius: 6px;
  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.18);
}

.brand-block.blue {
  background: linear-gradient(135deg, #1b6cf4 0%, #0b59d3 100%);
  transform: translate(-6px, 4px);
}

.brand-block.orange {
  background: linear-gradient(135deg, #ff9d21 0%, #f2731d 100%);
  transform: translate(6px, -4px);
}

.brand-name {
  font-size: 1.4rem;
  font-weight: 700;
  letter-spacing: -0.04em;
}

.main-nav {
  display: flex;
  align-items: center;
  gap: 26px;
  color: var(--muted);
  font-weight: 500;
}

.main-nav a {
  position: relative;
}

.main-nav a:hover::after,
.main-nav a:focus-visible::after {
  content: '';
  position: absolute;
  left: 0;
  bottom: -8px;
  width: 100%;
  height: 2px;
  background: var(--primary);
  border-radius: 99px;
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

.primary-btn,
.secondary-btn,
.ghost-btn {
  padding: 0.88rem 1.35rem;
  border-radius: 999px;
  font-weight: 600;
}

.primary-btn {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-strong) 100%);
  color: white;
  box-shadow: 0 18px 35px rgba(20, 119, 255, 0.26);
}

.primary-btn:hover {
  transform: translateY(-1px);
}

.secondary-btn {
  background: var(--panel);
  color: var(--text);
  border: 1px solid var(--line);
}

.ghost-btn {
  background: rgba(19, 32, 68, 0.03);
  color: var(--text);
  border: 1px solid var(--line);
}

.large {
  padding: 1rem 1.5rem;
}

.hero-section {
  display: grid;
  grid-template-columns: 1.05fr 0.95fr;
  align-items: center;
  gap: 48px;
  padding: 74px 0 40px;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  padding: 0.48rem 0.8rem;
  border-radius: 999px;
  background: rgba(20, 119, 255, 0.1);
  color: var(--primary-strong);
  font-size: 0.72rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  font-weight: 700;
}

.eyebrow.alt {
  background: rgba(15, 23, 42, 0.04);
  color: var(--muted);
}

.hero-copy h1 {
  margin: 18px 0 18px;
  font-size: clamp(2.8rem, 5vw, 5rem);
  line-height: 0.98;
  letter-spacing: -0.065em;
}

.hero-copy p {
  margin: 0;
  max-width: 620px;
  font-size: 1.1rem;
  line-height: 1.7;
  color: var(--muted);
}

.cta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  margin-top: 28px;
}

.hero-meta {
  margin-top: 22px;
  display: flex;
  align-items: center;
  gap: 12px;
  color: var(--muted);
  font-size: 0.96rem;
}

.hero-visual {
  display: flex;
  justify-content: center;
}

.screen-window {
  width: min(100%, 620px);
  background: linear-gradient(180deg, #111827 0%, #0f172a 100%);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 28px;
  box-shadow: var(--shadow);
  padding: 18px 18px 16px;
  position: relative;
  overflow: hidden;
}

.window-header {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 4px 8px 14px;
}

.dot {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  display: block;
}

.dot.red { background: #ff5f57; }
.dot.yellow { background: #febc2e; }
.dot.green { background: #28c840; }

.workspace-panel {
  display: grid;
  grid-template-columns: 160px 1fr;
  min-height: 480px;
  border-radius: 20px;
  overflow: hidden;
  background: linear-gradient(180deg, #f2f7ff 0%, #e9f1ff 100%);
}

.panel-sidebar {
  background: rgba(15, 23, 42, 0.04);
  border-right: 1px solid rgba(15, 23, 42, 0.08);
  padding: 18px 14px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 42px;
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.4);
  border: 1px solid rgba(15, 23, 42, 0.06);
  color: var(--muted);
  font-weight: 600;
}

.chip.active {
  background: linear-gradient(135deg, var(--primary) 0%, #3da6ff 100%);
  color: white;
}

.drawing-surface {
  position: relative;
  background: linear-gradient(180deg, #f9fbff 0%, #eef5ff 100%);
  overflow: hidden;
}

.grid-lines {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(15, 23, 42, 0.04) 1px, transparent 1px),
    linear-gradient(90deg, rgba(15, 23, 42, 0.04) 1px, transparent 1px);
  background-size: 26px 26px;
}

.draw-shape {
  position: absolute;
  border: 2px solid rgba(15, 23, 42, 0.78);
  background: rgba(20, 119, 255, 0.06);
}

.shape-one {
  width: 220px;
  height: 160px;
  left: 72px;
  top: 68px;
  border-radius: 20px 30px 28px 46px;
  transform: rotate(-10deg);
}

.shape-two {
  width: 150px;
  height: 150px;
  right: 84px;
  top: 120px;
  border-radius: 50%;
  background: rgba(58, 215, 183, 0.08);
}

.shape-three {
  width: 190px;
  height: 64px;
  left: 120px;
  bottom: 100px;
  border-radius: 30px;
  transform: rotate(18deg);
  background: rgba(123, 97, 255, 0.08);
}

.measure-card {
  position: absolute;
  right: 24px;
  bottom: 20px;
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid rgba(15, 23, 42, 0.06);
  box-shadow: 0 14px 30px rgba(15, 23, 42, 0.08);
  border-radius: 14px;
  padding: 12px 14px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.measure-card strong {
  font-size: 1.4rem;
}

.measure-card span {
  color: var(--muted);
  font-size: 0.76rem;
}

.stats-strip {
  display: grid;
  grid-template-columns: repeat(4, minmax(170px, 1fr));
  gap: 22px;
  padding: 26px 0 10px;
}

.stat-item {
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: 18px 16px;
  background: rgba(255, 255, 255, 0.8);
  border: 1px solid var(--line);
  border-radius: 20px;
}

.stat-item strong {
  font-size: clamp(1.5rem, 3vw, 2.4rem);
  letter-spacing: -0.06em;
}

.stat-item span {
  color: var(--muted);
  font-size: 0.88rem;
}

.feature-showcase,
.pricing-section {
  padding-top: 72px;
}

.section-heading {
  margin-bottom: 26px;
}

.section-heading h2 {
  margin: 18px 0 0;
  font-size: clamp(2rem, 4vw, 3.2rem);
  letter-spacing: -0.06em;
  line-height: 1.05;
  max-width: 700px;
}

.centered {
  text-align: center;
}

.centered h2 {
  margin-inline: auto;
}

.feature-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(220px, 1fr));
  gap: 22px;
}

.feature-card {
  padding: 26px 22px;
  border-radius: 24px;
  background: var(--panel);
  border: 1px solid var(--line);
  box-shadow: 0 10px 30px rgba(15, 23, 42, 0.02);
}

.feature-card h3 {
  margin: 18px 0 10px;
  font-size: 1.48rem;
  letter-spacing: -0.05em;
}

.feature-card p {
  margin: 0;
  color: var(--muted);
  line-height: 1.7;
}

.feature-icon {
  width: 52px;
  height: 52px;
  border-radius: 14px;
  background: linear-gradient(135deg, rgba(20, 119, 255, 0.14), rgba(20, 119, 255, 0.04));
  position: relative;
}

.feature-card.mint .feature-icon {
  background: linear-gradient(135deg, rgba(62, 215, 184, 0.16), rgba(62, 215, 184, 0.04));
}

.feature-card.gold .feature-icon {
  background: linear-gradient(135deg, rgba(255, 183, 3, 0.18), rgba(255, 183, 3, 0.06));
}

.feature-card.purple .feature-icon {
  background: linear-gradient(135deg, rgba(123, 97, 255, 0.16), rgba(123, 97, 255, 0.06));
}

.feature-card .feature-icon::before {
  content: '';
  position: absolute;
  inset: 15px;
  border-radius: 10px;
  background: rgba(15, 23, 42, 0.85);
  transform: rotate(45deg);
}

.solutions-panel {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(260px, 0.9fr);
  gap: 28px;
  align-items: center;
  background: linear-gradient(135deg, #0d172c 0%, #101828 100%);
  color: white;
  border-radius: 30px;
  padding: 44px 38px;
  margin-top: 72px;
}

.solutions-copy h2 {
  margin: 18px 0 16px;
  font-size: clamp(2.2rem, 3vw, 3rem);
  letter-spacing: -0.06em;
  line-height: 1.05;
}

.solutions-copy p {
  margin: 0;
  max-width: 620px;
  color: rgba(255, 255, 255, 0.72);
  line-height: 1.8;
}

.solutions-copy ul {
  margin: 20px 0 0;
  padding: 0 0 0 18px;
  color: rgba(255, 255, 255, 0.82);
  line-height: 2;
}

.workflow-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  justify-content: flex-end;
}

.workflow-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 52px;
  padding: 0.8rem 1rem;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 999px;
  color: rgba(255, 255, 255, 0.92);
  font-weight: 600;
}

.pricing-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(220px, 1fr));
  gap: 22px;
}

.price-card {
  display: flex;
  flex-direction: column;
  border-radius: 24px;
  background: var(--panel);
  border: 1px solid var(--line);
  padding: 24px 20px;
  min-height: 420px;
}

.price-card.featured {
  border-color: rgba(20, 119, 255, 0.4);
  box-shadow: 0 18px 48px rgba(20, 119, 255, 0.12);
  transform: translateY(-4px);
}

.plan-top {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.plan-label {
  display: inline-flex;
  width: fit-content;
  padding: 0.42rem 0.7rem;
  border-radius: 999px;
  background: rgba(20, 119, 255, 0.08);
  color: var(--primary-strong);
  font-size: 0.7rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

.plan-top h3 {
  margin: 0;
  font-size: 1.7rem;
  letter-spacing: -0.05em;
}

.plan-price {
  display: flex;
  align-items: end;
  gap: 6px;
  margin: 28px 0 20px;
}

.plan-price strong {
  font-size: clamp(2rem, 3vw, 2.7rem);
  letter-spacing: -0.06em;
}

.plan-price span {
  color: var(--muted);
  font-weight: 600;
}

.price-card ul {
  margin: 0 0 24px;
  padding-left: 18px;
  color: var(--muted);
  line-height: 2;
  list-style: disc;
}

.price-card button {
  margin-top: auto;
}

.customer-strip {
  padding-top: 72px;
}

.customer-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  margin-top: 22px;
}

.customer-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.8rem 1rem;
  min-width: 120px;
  background: rgba(15, 23, 42, 0.04);
  border: 1px solid var(--line);
  border-radius: 999px;
  color: var(--muted);
  font-weight: 700;
}

.site-footer {
  padding-top: 28px;
  margin-top: 32px;
  border-top: 1px solid var(--line);
}

.footer-links {
  display: flex;
  align-items: center;
  gap: 18px;
  color: var(--muted);
  font-weight: 600;
}

@media (max-width: 980px) {
  .hero-section,
  .solutions-panel {
    grid-template-columns: 1fr;
  }

  .feature-grid,
  .pricing-grid,
  .stats-strip {
    grid-template-columns: repeat(2, minmax(220px, 1fr));
  }

  .workflow-list {
    justify-content: flex-start;
  }
}

@media (max-width: 720px) {
  .page-shell {
    padding-inline: 16px;
  }

  .topbar,
  .site-footer {
    flex-wrap: wrap;
  }

  .main-nav {
    order: 3;
    width: 100%;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
  }

  .nav-actions {
    margin-left: auto;
  }

  .feature-grid,
  .pricing-grid,
  .stats-strip {
    grid-template-columns: 1fr;
  }

  .workspace-panel {
    grid-template-columns: 1fr;
  }

  .panel-sidebar {
    border-right: none;
    border-bottom: 1px solid rgba(15, 23, 42, 0.08);
    flex-direction: row;
    flex-wrap: wrap;
  }

  .screen-window {
    padding: 12px;
  }

  .solutions-panel {
    padding: 28px 20px;
  }
}
